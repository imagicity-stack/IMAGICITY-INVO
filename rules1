rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function nonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function isServerTimestamp(value) {
      return value is timestamp || value == request.time;
    }

    function optionalTimestamp(data, field) {
      return !(field in data) || isServerTimestamp(data[field]);
    }

    function optionalString(data, field) {
      return !(field in data) || data[field] is string;
    }

    function optionalNumberMin(data, field, minValue) {
      return !(field in data) || (data[field] is number && data[field] >= minValue);
    }

    function optionalEnum(data, field, options) {
      return !(field in data) || data[field] in options;
    }

    function optionalBoolean(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function isValidBillingAddress(address) {
      return address is map
        && nonEmptyString(address.line1)
        && nonEmptyString(address.city)
        && nonEmptyString(address.state)
        && nonEmptyString(address.country)
        && nonEmptyString(address.pincode)
        && nonEmptyString(address.stateCode)
        && optionalString(address, 'line2');
    }

    function isValidClient(data) {
      return nonEmptyString(data.clientId)
        && data.clientType in ['Individual', 'Business', 'Startup', 'Enterprise']
        && nonEmptyString(data.legalName)
        && nonEmptyString(data.contactPerson)
        && nonEmptyString(data.email)
        && nonEmptyString(data.phone)
        && data.status in ['Active', 'On Hold', 'Inactive', 'Blacklisted']
        && nonEmptyString(data.currency)
        && data.paymentTerms in ['Due on Receipt', 'Net 7', 'Net 15', 'Net 30']
        && data.preferredPaymentMode in ['UPI', 'Bank Transfer', 'Cheque', 'Online Gateway']
        && data.taxPreference in ['Inclusive', 'Exclusive']
        && data.clientSource in ['Instagram', 'Referral', 'Website', 'Cold Outreach', 'Other']
        && data.gstRegistered is bool
        && optionalString(data, 'brandName')
        && optionalString(data, 'gstin')
        && optionalString(data, 'pan')
        && optionalString(data, 'accountOwner')
        && optionalString(data, 'industryType')
        && optionalString(data, 'notes')
        && data.autoSendInvoice is bool
        && data.autoReminderEnabled is bool
        && data.lateFeeApplicable is bool
        && data.isArchived is bool
        && optionalNumberMin(data, 'creditLimit', 0)
        && optionalNumberMin(data, 'reminderFrequencyDays', 0)
        && (!('tags' in data) || data.tags is list)
        && isValidBillingAddress(data.billingAddress)
        && optionalTimestamp(data, 'createdAt')
        && optionalTimestamp(data, 'updatedAt');
    }

    function isValidService(data, id) {
      return data.serviceId == id
        && nonEmptyString(data.name)
        && optionalEnum(data, 'type', ['Service', 'Package', 'Add-on'])
        && nonEmptyString(data.category)
        && optionalEnum(data, 'pricingModel', ['Fixed', 'Hourly', 'Monthly', 'Per Unit'])
        && optionalEnum(data, 'status', ['Active', 'Inactive'])
        && data.rate is number && data.rate >= 0
        && optionalNumberMin(data, 'gstRate', 0) && (!("gstRate" in data) || data.gstRate <= 28)
        && optionalBoolean(data, 'taxIncluded')
        && optionalBoolean(data, 'requiresBrief')
        && optionalBoolean(data, 'isArchived')
        && nonEmptyString(data.unitLabel)
        && optionalString(data, 'currency') && (!('currency' in data) || nonEmptyString(data.currency))
        && optionalString(data, 'description')
        && optionalString(data, 'notesInternal')
        && optionalNumberMin(data, 'turnaroundDays', 0)
        && optionalNumberMin(data, 'internalCost', 0)
        && (!('deliverables' in data) || data.deliverables is list)
        && (!('tags' in data) || data.tags is list)
        && optionalTimestamp(data, 'createdAt')
        && optionalTimestamp(data, 'updatedAt');
    }

    function isValidServiceCategory(data, id) {
      return data.categoryId == id
        && nonEmptyString(data.name)
        && optionalTimestamp(data, 'createdAt');
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /clients/{clientId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidClient(request.resource.data);
      allow delete: if isSignedIn();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidService(request.resource.data, serviceId);
      allow update: if isSignedIn() && isValidService(request.resource.data, serviceId);
      allow delete: if false; // use archive instead of deletes
    }

    match /serviceCategories/{categoryId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidServiceCategory(request.resource.data, categoryId);
      allow update: if isSignedIn() && isValidServiceCategory(request.resource.data, categoryId);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
